{
  "name": "pj1-svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "PJ1 Phase 1: an object-oriented SVG command-line editor",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "cli": "npm run build && node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "npm run build && vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "demo:model": "npm run build && node examples/ModelDemo.mjs",
    "demo:commands": "npm run build && node examples/CommandDemo.mjs",
    "demo:views": "npm run build && node examples/ViewDemo.mjs",
    "demo:svg": "npm run build && node examples/SvgDemo.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
